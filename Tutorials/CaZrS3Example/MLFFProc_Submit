#!/bin/bash
#SBATCH --job-name=NequipOnTheFly
#SBATCH --partition=small_gpu8
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=72
#SBATCH --gpus-per-node=8
#SBATCH --gpus=8
#SBATCH --time=23:30:00
#SBATCH --mail-type=NONE 
#SBATCH --output=%x_%j.out

module purge
module load anaconda3/2021.11
module load cuda
eval "$(conda shell.bash hook)"
conda activate MACE_ENV                # If you name the environment something else, change this line accordingly.
                                       # You can install the environment in any other environment manager as well, just make sure to change the activation command accordingly.
conda info --envs
# ============================================================================
# TODO: Configure VASP module loading for your HPC system
# Replace the lines below with appropriate VASP module commands for your cluster
# Check available modules with: module avail VASP
# Example alternatives:
#   module load VASP/6.4.1
#   module load vasp/6.4.1-intel-2021b
# ============================================================================
module use --append /path/to/VASP/modulefiles/VASP/
module load 6.4.1-mpi-ifx-old
module load VASP 2>&1    #It is important that vasp_std is loaded correctly here.
python -u -m OTFFineTune.procs.MLFFProc